# LLM (M7 — AI assistant). OpenRouter free tier: https://openrouter.ai/keys
# `openrouter/free` is the auto-router over free models and is verified to do tool calling.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free

# Auth
# Secret used to sign HA256 session JWTs. Generate with: openssl rand -base64 32
# Falls back to a constant dev secret when unset (dev only).
AUTH_SECRET=

# DB (SQLite default; `file:` prefix is stripped)
DATABASE_URL=file:./dev.db

# First-run bypass (optional): when both are set and no company exists yet,
# opening the app creates the company + admin automatically — no setup wizard.
COMPANY_NAME=HCM Lite
ADMIN_EMAIL=
ADMIN_PASSWORD=
